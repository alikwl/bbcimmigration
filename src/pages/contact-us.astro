---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { siteConfig } from '../data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Contact Us', item: '/contact-us/' }
];
---

<BaseLayout 
  title="Contact Us" 
  description="Get in touch with Busy Bee Canada in Barrie, Ontario. Submit an evaluation request, call us, or visit our office."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="contact-hero">
    <div class="container text-center">
      <h1 class="animate-fade-in">Contact Busy Bee Canada</h1>
      <p class="subtitle animate-fade-in">Have questions or want to check your options? Reach out to us today.</p>
    </div>
  </section>

  <!-- Grid layout -->
  <section class="contact-section container section-padding">
    <div class="contact-grid">
      <!-- Contact Info & Map -->
      <div class="contact-info-panel">
        <h2>Office Location & Details</h2>
        <p class="intro-p">Our primary office is located in Barrie, Ontario. We schedule in-person appointments by reservation or host consultation meetings digitally via Zoom/Google Meet.</p>
        
        <div class="contact-details-cards">
          <div class="detail-card card">
            <span class="icon">📍</span>
            <div class="detail-text">
              <h3>Office Address</h3>
              <p>{siteConfig.address}</p>
            </div>
          </div>

          <div class="detail-card card">
            <span class="icon">📞</span>
            <div class="detail-text">
              <h3>Phone Contacts</h3>
              <p>Direct: <a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></p>
              <p>Toll-Free: <a href={`tel:${siteConfig.tollFree}`}>{siteConfig.tollFree}</a></p>
            </div>
          </div>

          <div class="detail-card card">
            <span class="icon">✉️</span>
            <div class="detail-text">
              <h3>Email & Support</h3>
              <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
            </div>
          </div>

          <div class="detail-card card">
            <span class="icon">🕒</span>
            <div class="detail-text">
              <h3>Office Hours</h3>
              <p>{siteConfig.officeHours}</p>
            </div>
          </div>
        </div>

        <!-- Stylized Map Placeholder -->
        <div class="map-placeholder-box card">
          <h3>Interactive Map</h3>
          <div class="map-visual">
            <svg viewBox="0 0 500 250" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="500" height="250" fill="#1e2937" rx="8" />
              <!-- Map lines -->
              <path d="M50 0 L50 250 M150 0 L150 250 M300 0 L300 250 M450 0 L450 250" stroke="#374151" stroke-width="2" />
              <path d="M0 50 L500 50 M0 120 L500 120 M0 200 L500 200" stroke="#374151" stroke-width="2" />
              <!-- Highlighting office -->
              <circle cx="300" cy="120" r="12" fill="rgba(59, 130, 246, 0.3)" />
              <circle cx="300" cy="120" r="6" fill="#eab308" />
              <text x="320" y="125" font-family="Outfit" font-size="14" font-weight="700" fill="#ffffff">BBC Office</text>
              <text x="320" y="142" font-family="Plus Jakarta Sans" font-size="10" fill="#9ca3af">Suite #220E, Barrie</text>
            </svg>
          </div>
        </div>
      </div>

      <!-- Eligibility Form -->
      <div class="contact-form-panel">
        <LeadForm 
          formId="contactPageForm"
          title="Direct Inquiry & Evaluation"
          subtitle="Submit your details below, and an immigration case manager will contact you within 1 business day."
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background: linear-gradient(135deg, #0b0f19 0%, #111827 100%);
    padding: 5rem 0 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 1rem auto 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4.5rem;
  }

  .contact-info-panel h2 {
    margin-bottom: 1rem;
  }

  .intro-p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .contact-details-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .detail-card {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    align-items: flex-start;
  }

  .detail-card .icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .detail-text h3 {
    font-size: 1rem;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .detail-text p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  
  .detail-text a {
    color: inherit;
  }
  .detail-text a:hover {
    color: #ffffff;
  }

  .map-placeholder-box h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .map-visual svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--border-radius-sm);
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 576px) {
    .contact-details-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
