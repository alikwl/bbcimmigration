---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Cookie Policy', item: '/cookie-policy/' }
];
---

<BaseLayout 
  title="Cookie Policy" 
  description="Learn about the cookies and tracking technologies used on the Busy Bee Canada website."
  breadcrumbs={breadcrumbs}
>
  <section class="legal-hero">
    <div class="container text-center">
      <h1>Cookie Policy</h1>
      <p class="subtitle">Effective Date: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </div>
  </section>

  <section class="legal-content container section-padding">
    <div class="legal-text-wrapper card">
      <h2>1. What Are Cookies?</h2>
      <p>Cookies are small text files placed on your computer or mobile device when you visit a website. They are widely used to make websites work or work more efficiently, as well as to provide reporting information.</p>
      
      <h2>2. How We Use Cookies</h2>
      <p>We use cookies to enhance your browsing experience, specifically:</p>
      <ul>
        <li><strong>Necessary Cookies:</strong> Required to enable core site functionality such as forms submission and layout security.</li>
        <li><strong>Performance and Analytics Cookies:</strong> Allow us to monitor traffic and understand which pages are visited most frequently (e.g., using Google Analytics or basic web beacons).</li>
      </ul>

      <h2>3. Controlling Your Cookies</h2>
      <p>You can set or amend your web browser controls to accept or refuse cookies. If you choose to reject cookies, you may still use our website, though your access to some functionality and areas of our website may be restricted.</p>

      <h2>4. Updates to This Policy</h2>
      <p>We may update this Cookie Policy from time to time in order to reflect changes to the cookies we use or for other operational, legal, or regulatory reasons.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    background: linear-gradient(135deg, #0b0f19 0%, #1f2937 100%);
    padding: 4rem 0 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .subtitle {
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .legal-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .legal-text-wrapper {
    padding: 3rem;
  }

  .legal-text-wrapper h2 {
    font-size: 1.5rem;
    margin: 2rem 0 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.5rem;
  }

  .legal-text-wrapper h2:first-of-type {
    margin-top: 0;
  }

  .legal-text-wrapper p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .legal-text-wrapper ul {
    list-style: square;
    padding-left: 2rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .legal-text-wrapper li {
    margin-bottom: 0.5rem;
  }
</style>
