---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: '404 Not Found', item: '/404/' }
];
---

<BaseLayout 
  title="Page Not Found" 
  description="The page you are looking for does not exist."
  breadcrumbs={breadcrumbs}
>
  <section class="error-section container text-center section-padding">
    <div class="error-card card glass">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-accent">Go to Home Page</a>
        <a href="/services/" class="btn btn-outline">Explore Our Services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    max-width: 600px;
    margin: 4rem auto;
  }

  .error-card {
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .error-code {
    font-size: 6rem;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .error-card p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (max-width: 576px) {
    .error-actions {
      flex-direction: column;
      width: 100%;
    }
    .error-actions .btn {
      width: 100%;
    }
  }
</style>
